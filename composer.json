{
    "name": "elkuku/minicc-kuku",
"description": "Mini CC Manager",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pcre": "*",
"doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.3",
        "elkuku/intl-numbers-to-words": "1.*",
        "elkuku/kuku-sf-system-tools-bundle": "^1.0",
        "google/apiclient": "^2.13",
        "h4cc/wkhtmltopdf-amd64": "^0.12.3",
        "knplabs/knp-snappy": "^1.7.2",
        "knplabs/knp-snappy-bundle": "dev-master",
        "oro/doctrine-extensions": "^3.0-beta1",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "8.*",
        "symfony/asset-mapper": "8.*",
        "symfony/console": "8.*",
        "symfony/dotenv": "8.*",
        "symfony/expression-language": "8.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.*",
        "symfony/framework-bundle": "8.*",
        "symfony/google-mailer": "8.*",
        "symfony/mailer": "8.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/process": "8.*",
        "symfony/property-access": "8.*",
        "symfony/property-info": "8.*",
        "symfony/runtime": "8.*",
        "symfony/security-bundle": "8.*",
        "symfony/sendgrid-mailer": "8.*",
        "symfony/serializer": "8.*",
        "symfony/string": "8.*",
        "symfony/translation": "8.*",
        "symfony/twig-bundle": "8.*",
        "symfony/ux-chartjs": "^3.4",
        "symfony/ux-icons": "^3.4",
        "symfony/ux-twig-component": "^3.4",
        "symfony/validator": "8.*",
        "symfony/web-link": "8.*",
        "symfony/yaml": "8.*",
        "twig/cssinliner-extra": "^3.19",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/inky-extra": "^3.20",
        "twig/intl-extra": "^3.3",
        "twig/string-extra": "^3.5",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "elkuku/symfony-utils": "dev-master",
        "friendsofphp/php-cs-fixer": "^3.95",
        "jawira/doctrine-diagram-bundle": "dev-main",
        "phpstan/extension-installer": "^1.2",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "8.*",
        "symfony/css-selector": "8.*",
        "symfony/debug-bundle": "8.*",
        "symfony/maker-bundle": "^1.29",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/stopwatch": "8.*",
        "symfony/web-profiler-bundle": "8.*",
        "tomasvotruba/cognitive-complexity": "^1.0",
        "zenstruck/foundry": "^2.9"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php56": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test-phpunit": ["make tests"],
        "test-phpstan": ["vendor/bin/phpstan analyse --memory-limit=2G"],
        "ci": ["@test-phpunit", "@test-phpstan"],
        "coverage": ["APP_ENV=test symfony console doctrine:database:drop --force || true", "APP_ENV=test symfony console doctrine:database:create", "XDEBUG_MODE=coverage php vendor/bin/phpunit --coverage-text"],
        "coverage-html": ["APP_ENV=test symfony console doctrine:database:drop --force || true", "APP_ENV=test symfony console doctrine:database:create", "XDEBUG_MODE=coverage php vendor/bin/phpunit --coverage-html coverage"],
        "check" : [
            "echo 'Check for outdated assets:'",
            "bin/console importmap:outdated",
            "echo '**************************'",
            "echo ''",
            "echo 'Check for outdated PHP deps:'",
            "composer outdated",
            "echo '**************************'",
            "echo ''",
            "echo 'Check for outdated Recipes:'",
            "composer recipes:update",
            "echo '**************************'",
            "echo ''"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.*",
            "docker": true
        }
    }
}
