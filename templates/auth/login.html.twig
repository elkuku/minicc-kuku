{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Ingresar{% endblock %}

{% block body %}
    <span {{ stimulus_controller('background') }}></span>
    <div class="row justify-content-center py-5">
        <div class="col-sm-10 col-md-7 col-lg-5">
            <div class="card shadow bg-body bg-opacity-75">
                <div class="card-body p-4 text-center">
                    <h2 class="card-title mb-3">Ingresar</h2>
                    <p class="text-body-secondary">
                        Solo para clientes registrados del MiniCC KuKu.<br>
                        Ingrese con su cuenta de Google.
                    </p>
                    <div class="d-flex justify-content-center my-4">
                        {% include '_google_signin_button.html.twig' %}
                    </div>
                    <p class="small text-body-secondary mb-0">
                        ¿No puede ingresar? Contacte al administrador.
                    </p>
                </div>
            </div>

            {% if app.environment in ['dev', 'test'] %}
                <div class="card shadow bg-body bg-opacity-75 mt-4">
                    <div class="card-body p-4">
                        <h2 class="h5 card-title">Dev</h2>
                        <form role="form" method="post" action="{{ path('login') }}">
                            {% if error %}
                                <div class="alert alert-danger">
                                    {{ error.message }}
                                </div>
                            {% endif %}

                            <div class="input-group">
                                <input id="identifier" class="form-control" name="identifier"
                                       value="{{ last_username }}"
                                       placeholder="email" required autofocus
                                >
                                <button type="submit" class="btn btn-primary">Login</button>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('login') }}">
                        </form>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
